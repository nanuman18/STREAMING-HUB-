# ---------------------------------------------------------------------------
# Streaming Hub — variables de entorno. Copia este archivo a .env y rellénalo.
# El token de TMDB solo se usa en el servidor: nunca aparece en manifiestos,
# en la página de configuración ni en las URL de instalación.
# ---------------------------------------------------------------------------

# Credenciales TMDB (una de las dos). Recomendado: "API Read Access Token" (v4).
# themoviedb.org → Ajustes → API
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Servidor
PORT=7000
HOST=0.0.0.0
# URL pública HTTPS con la que se accede al addon (solo informativa en los registros).
PUBLIC_URL=

# Datos
DB_PATH=./data/streaming-hub.db
PLATFORMS_FILE=./config/platforms.json
# Países que se sincronizan (ISO 3166-1, separados por comas). Cada país multiplica las peticiones.
SYNC_REGIONS=ES
# Idioma de títulos, sinopsis y géneros
TMDB_LANGUAGE=es-ES

# Sincronización automática
SYNC_ENABLED=true
SYNC_INCREMENTAL_HOURS=6
SYNC_FULL_HOURS=24
# Páginas por ordenación (popularidad y estreno reciente) en la incremental
SYNC_INCREMENTAL_PAGES=5
# Tipos de oferta que cuentan como "disponible en la plataforma": flatrate (suscripción), free, ads, rent, buy
SYNC_MONETIZATION=flatrate,free,ads
# Días para volver a buscar el IMDb ID de títulos que no lo tenían
IMDB_RETRY_DAYS=3
# Solo desarrollo: limitar plataformas (claves de platforms.json) y páginas por consulta (0 = sin límite)
SYNC_PLATFORMS=
SYNC_MAX_PAGES=0

# Ritmo de peticiones a TMDB (TMDB admite ~50/s por IP; se deja margen)
TMDB_MAX_RPS=30
TMDB_CONCURRENCY=12
TMDB_MAX_RETRIES=5

# debug | info | warn | error
LOG_LEVEL=info
